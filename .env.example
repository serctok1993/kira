# Cloud-first: trage hier deine Keys ein und kopiere die Datei zu .env
# OHNE Keys faellt der Router automatisch auf das lokale Ollama-Modell zurueck (0 EUR).
# Universeller Anbieter (empfohlen): EIN Key -> hunderte Modelle aller Firmen.
# Key holen: https://openrouter.ai/keys  ->  dann z.B. /model use openrouter/anthropic/claude-opus-4-8
OPENROUTER_API_KEY=

# Einzel-Anbieter (optional, nur falls du sie direkt nutzen willst)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Telegram-Bot (via @BotFather anlegen: /newbot -> Token hierher)
TELEGRAM_BOT_TOKEN=
