# Kira — Umgebungs-Schluessel (Kopie dieser Datei als .env ablegen: `cp .env.example .env`)
#
# ALLES HIER IST OPTIONAL. Ohne Keys laeuft Kira komplett lokal ueber Ollama (0 EUR) —
# Cloud-Funktionen degradieren still mit klaren Hinweisen statt zu crashen.
# Bequemer Weg: der /setup-Wizard und der Cockpit-Tresor (Zugaenge) speichern
# Schluessel in data/secrets.json (gitignored) — dann braucht es diese Datei gar nicht.

# Universeller Cloud-Anbieter (empfohlen): EIN Key -> hunderte Modelle aller Firmen.
# Key holen: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Einzel-Anbieter (optional, nur falls du sie direkt nutzen willst)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Telegram-Bot (via @BotFather anlegen: /newbot -> Token hierher; Chat-ID setzt der /setup-Wizard)
TELEGRAM_BOT_TOKEN=

# Eigenes Postfach des Agenten (optional; Hosts fuer Gmail/Outlook/GMX/web.de automatisch)
SMTP_USER=
SMTP_PASS=

# Sprachausgabe (optional)
ELEVENLABS_API_KEY=

# Social (optional): Bluesky-Handle + App-Passwort
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
